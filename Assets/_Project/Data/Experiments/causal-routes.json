    "declaration_note": "One route per frozen rule. Each rule's authored note describes a different reason, so no two frozen rules are declared to be the same route. Every relation between routes is independent unless a what-if below says otherwise. Roles are driver for a positive coefficient and inhibitor for a negative one, except where declared.",
    "routes": [
      { "rule": "pulling_rank_needs_an_audience", "route": "authority_shown_to_witnesses",
        "means": "Asserting authority as something done in front of others: it is authority rather than housekeeping because somebody is there to see it." },
      { "rule": "being_the_one_who_decides_it", "route": "settling_is_mine",
        "means": "Settling the matter because settling such things is one's own place, audience or not; being angry already makes it stronger." },
      { "rule": "somebody_has_to_do_it", "route": "a_job_that_needed_doing",
        "means": "Doing it because it needed doing and somebody had to." },
      { "rule": "doing_it_where_nobody_is_watching", "route": "proving_it_to_myself",
        "means": "Doing it to prove it to oneself rather than to anyone else, which only makes sense unwatched." },
      { "rule": "so_that_they_know_too", "route": "finding_out_for_the_room",
        "means": "Finding out on behalf of the others present, so that they know too." },
      { "rule": "standing_between_them_and_it", "route": "standing_in_the_way",
        "means": "Protecting somebody by putting oneself physically in the way of what threatens them." },
      { "rule": "keeping_it_off_them", "route": "shielding_from_afar",
        "means": "Protecting somebody by keeping a matter away from them, including when they are not there." },
      { "rule": "not_making_a_scene_of_it", "route": "defusing_the_scene",
        "means": "Keeping things from becoming a scene in front of others; a dominant person settles rather than defuses.",
        "roles": { "trait:dominant": "inhibitor" } },
      { "rule": "letting_it_go_for_now", "route": "letting_it_go",
        "means": "Choosing not to have it out yet, with nobody there to have it out with." },
      { "rule": "what_you_did_in_the_night", "route": "owning_the_night",
        "means": "Taking one's own act as a theft, which is only possible for somebody who believes they are answerable for the missing can: the belief is the condition, and honesty, fairness and shame are what act on it.",
        "roles": { "belief:answerable_for($self,missing_can)": "enabler" } }
    ],
    "relations": [],
    "what_if_alternatives": [
